VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase App Check / reCAPTCHA Enterprise.
# Leave empty until the web app is registered in Firebase App Check.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Localhost only. Set to true to print a debug token in the browser console,
# then register that token in Firebase Console -> App Check -> Debug tokens.
VITE_APP_CHECK_DEBUG=false

# Optional: put a previously registered debug token here instead of true mode.
VITE_APP_CHECK_DEBUG_TOKEN=

# Normal dialogue goes through the Cloudflare Worker. Provider API keys must
# stay in Cloudflare Production Secrets and never belong in this frontend file.
# Optional override; production normally uses the built-in Worker endpoint.
VITE_CLOUD_LANGUAGE_ENDPOINT=

# SERVER-ONLY CLOUDFLARE WORKER VARIABLES (do NOT prefix with VITE_):
#   OPENAI_API_KEY            = configured in Cloudflare Secrets
#   WAVESPEED_API_KEY         = configured in Cloudflare Secrets
#   ALEXANDRA_LORA_URL        = optional override for LoRA (.safetensors default is server-side)
#   ALEXANDRA_LORA_SCALE      = 0.85 (optional; Worker default)
#   PHOTO_SIGNING_KEY        = separate Worker secret for signing GPT image decisions (optional, recommended)
# NEVER put LoRA URL or API keys in frontend .env or public/runtime-config.js.
